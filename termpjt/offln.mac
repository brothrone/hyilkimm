! ==================================================================
!  offln.mac : 안쪽 직선 2개를 바깥쪽으로 30 mm 평행이동(offset)한 선 만들기
!  (메모장에서 파일 이름 offln.mac 으로 ANSYS 작업 폴더에 저장)
!
!  [손계산]  cos45 = sin45 = 0.707107,  cos15 = 0.965926,  sin15 = 0.258819
!
!  (1) 45도 직선  A(327.157288, 260) - B(208.578644, 141.421356)
!      선에 수직인 바깥 방향 = (0.707107, -0.707107)
!      B'  = B + 30*(0.707107, -0.707107) = (229.791847, 120.208153)
!      A'' = 입구 높이 y=260 에서의 바깥선 위치
!          = A 에서 가로로 30/cos45 = 42.426406 만큼 = (369.583694, 260)
!
!  (2) 15도 직선  D(151.703709, -12.940952) - E(477.411774, -1228.5)
!      선에 수직인 바깥 방향 = (0.965926, 0.258819)
!      D'  = D + 30*(0.965926, 0.258819) = (180.681483, -5.176381)
!      E'' = 출구 높이 y=-1228.5 에서의 바깥선 위치
!          = E 에서 가로로 30/cos15 = 31.058285 만큼 = (508.470059, -1228.5)
! ==================================================================
k,3,369.583694,260
k,4,229.791847,120.208153
l,3,4                        ! L1 : 바깥 45도 직선

k,7,180.681483,-5.176381
k,8,508.470059,-1228.5
l,7,8                        ! L2 : 바깥 15도 직선
